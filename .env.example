# Local development settings for the Docker Compose stack (infra/docker-compose.yml).
#
# Do not edit this file to hold real values. Run `make dev` (or
# `uv run python scripts/gen_dev_env.py`) and it creates `.env` next to this file,
# filling every empty secret below with a strong random value. It never overwrites
# an existing `.env`.
#
# Secrets are left empty on purpose. Compose refuses to start when a required
# secret is missing (fail closed, no default secrets).

# ---------------------------------------------------------------- compose
# Compose project name (prefix for containers, networks and volumes).
COMPOSE_PROJECT_NAME=pairly

# Host ports. Every port is bound to 127.0.0.1 only.
PAIRLY_API_PORT=8000
# Host port of the web app (the container listens on 3000 inside).
PAIRLY_WEB_PORT=3100
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025
CLAMAV_HOST_PORT=3310
LANGFUSE_HOST_PORT=3200

# ---------------------------------------------------------------- app
# development | test | production
PAIRLY_ENV=development
PAIRLY_LOG_LEVEL=INFO
# recorded (offline replay of cached model responses) | live (needs a provider key)
PAIRLY_MODEL_MODE=recorded
# Public URLs as seen from the browser.
PAIRLY_PUBLIC_API_URL=http://localhost:8000
PAIRLY_PUBLIC_WEB_URL=http://localhost:3100

# Better Auth JWT issuer and audience the API accepts (the web app's base URL locally).
PAIRLY_AUTH_ISSUER=http://localhost:3100
PAIRLY_AUTH_AUDIENCE=http://localhost:3100
# Extra exact origins the web app's auth server trusts besides PAIRLY_PUBLIC_WEB_URL
# (comma separated, scheme://host[:port], no wildcards or paths). Example for opening the
# app or running the e2e suite at the IP address: http://127.0.0.1:3100
PAIRLY_AUTH_TRUSTED_ORIGINS=
# Exact browser origins allowed to call the API (comma separated).
PAIRLY_CORS_ORIGINS=http://localhost:3100
# Platform operations (brief 5.1 item 15): the id of the organisation whose admins run
# this deployment. Only they see GET /v1/ops/dashboard (every organisation, numbers
# only, never tenant content) and the job runs. Empty: nobody does.
PAIRLY_SYSTEM_ORG_ID=

# Application-level encryption (AES-256-GCM envelope encryption, pairly_core.crypto).
# Key encryption keys: PAIRLY_KEK_<version>, base64, 32 bytes each. New data is wrapped
# with PAIRLY_KEK_CURRENT. To rotate: add PAIRLY_KEK_2, set PAIRLY_KEK_CURRENT=2, restart,
# run `uv run pairly-admin crypto rotate`, and remove PAIRLY_KEK_1 only once
# `pairly-admin crypto rotate --dry-run` reports nothing left. Secret.
PAIRLY_KEK_1=
PAIRLY_KEK_CURRENT=1
# Optional second key slot, used only during a rotation. Secret.
PAIRLY_KEK_2=
# HMAC key for blind indexes on encrypted searchable fields (base64url, 32 bytes). Secret.
# Must differ from every KEK. This is blind index key version 1.
PAIRLY_BLIND_INDEX_KEY=
# Blind index key rotation: add PAIRLY_BLIND_INDEX_KEY_2 and restart everything (lookups
# then try both keys), set PAIRLY_BLIND_INDEX_KEY_CURRENT=2 and restart (new indexes use
# key 2), run `uv run pairly-admin crypto rotate-blind-index` until its --dry-run reports
# nothing left, then remove the old key. Secret; empty means unset.
PAIRLY_BLIND_INDEX_KEY_2=
PAIRLY_BLIND_INDEX_KEY_CURRENT=1
# HMAC key for signed single-use links (approvals, portals). Secret.
PAIRLY_SIGNED_LINK_SECRET=
# HMAC pepper for API key hashes (base64url, at least 32 bytes). Secret. Changing it
# invalidates every API key.
PAIRLY_API_KEY_PEPPER=

# Audit chain anchoring (WP1.10b). Every night the worker signs each organisation's
# audit chain head with this Ed25519 key and writes it to write-once object storage, so
# removing the newest audit events is detectable. Base64url of a 32-byte seed. Only the
# worker gets it, never the API or the database; the worker refuses to start without
# it. Secret.
PAIRLY_AUDIT_SIGNING_KEY=
# The matching public key (generated with the signing key). The API checks anchors with
# it and publishes it at GET /v1/audit/anchor-key. Required in production.
PAIRLY_AUDIT_ANCHOR_PUBLIC_KEY=
# Anchor bucket (created with S3 object lock by minio-init), lock mode and retention.
# Lock modes: GOVERNANCE (local), COMPLIANCE (production), none (a store without object
# lock: anchors are then only write-once by conditional puts and the access policy).
PAIRLY_AUDIT_ANCHOR_BUCKET=pairly-audit-anchors
PAIRLY_AUDIT_ANCHOR_LOCK_MODE=GOVERNANCE
PAIRLY_AUDIT_ANCHOR_RETENTION_DAYS=2555

# Model providers. Optional: empty means recorded mode only.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Default monthly model budget per organisation, USD (hard stop, alerts at 80% and 100%).
PAIRLY_LLM_MONTHLY_BUDGET_USD=20
# Live mode: reuse the answer to an identical request of the same organisation instead
# of calling the model again (identical input, identical output, no cost). Days kept.
PAIRLY_LLM_REUSE_RESPONSES=true
PAIRLY_LLM_REUSE_TTL_DAYS=30

# ---------------------------------------------------------------- postgres
# Database name used by the API, worker and Better Auth (schema `auth`).
POSTGRES_DB=pairly
# Bootstrap superuser. Only used by the init scripts and for admin work. Secret.
POSTGRES_PASSWORD=
# Owner and migration role `pairly_owner`: owns schemas and tables, runs Alembic. Secret.
PAIRLY_OWNER_DB_PASSWORD=
# Application role `pairly_app`: not the owner, no BYPASSRLS, so Row Level Security applies. Secret.
PAIRLY_APP_DB_PASSWORD=
# Better Auth role `pairly_auth`: owns only the `auth` schema, no rights on `public`. Secret.
PAIRLY_AUTH_DB_PASSWORD=

# ---------------------------------------------------------------- redis
# Password for Redis (arq queue; LangFuse uses database 1 when enabled). Secret.
REDIS_PASSWORD=

# ---------------------------------------------------------------- object storage (MinIO)
# Root credentials, used only by the bucket-init job and the console. Secret.
MINIO_ROOT_USER=pairly-root
MINIO_ROOT_PASSWORD=
# Bucket for uploaded documents.
PAIRLY_S3_BUCKET=pairly-documents
# Least-privilege access key for the API and worker (read/write on PAIRLY_S3_BUCKET only).
PAIRLY_S3_ACCESS_KEY=pairly-app
# Secret.
PAIRLY_S3_SECRET_KEY=

# ---------------------------------------------------------------- documents (ingestion and parsing)
# Inbound email addresses are <workflow>+<org-slug>.<token>@<this domain>. The token is
# secret per org and workflow: create or rotate it with
# `uv run pairly-admin inbound rotate --org <uuid> --workflow pay` (printed once).
PAIRLY_INBOUND_EMAIL_DOMAIN=inbound.pairly.localhost
# Hard cap for any upload, in bytes (25 MiB). Per-workflow limits and types can be set
# with PAIRLY_INTAKE_POLICIES, a JSON object such as
# {"pay": {"allowed_types": ["application/pdf", "image/png"], "max_bytes": 10485760}}
PAIRLY_MAX_UPLOAD_BYTES=26214400
# Lifetime of signed download URLs, in seconds.
PAIRLY_SIGNED_URL_TTL_SECONDS=60
# Parser sandbox (worker): parses at once, memory per parse (MB), OCR languages.
PAIRLY_PARSE_CONCURRENCY=1
PAIRLY_PARSE_MEMORY_MB=512
PAIRLY_OCR_LANGUAGES=eng+ara

# ---------------------------------------------------------------- email (Mailpit locally)
PAIRLY_SMTP_FROM="Pairly <no-reply@pairly.localhost>"

# ---------------------------------------------------------------- auth (Better Auth in apps/web)
# Signing secret for Better Auth sessions. Secret.
BETTER_AUTH_SECRET=
# Staff are invite-only: there is no open sign-up. Create the first organisation and its
# admin invitation with `make bootstrap-org` (see apps/web/README.md).
# SSO credentials. Optional, each provider stays off unless both its id and secret are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Microsoft Entra tenant: common, organizations, consumers or a tenant id.
MICROSOFT_TENANT_ID=common

# ---------------------------------------------------------------- observability (profile: observability)
# LangFuse role and database `langfuse` in our Postgres. Secret.
LANGFUSE_DB_PASSWORD=
# LangFuse internal secrets. Secret.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# 64 hex characters. Secret.
LANGFUSE_ENCRYPTION_KEY=
# ClickHouse password (LangFuse analytics store). Secret.
CLICKHOUSE_PASSWORD=
# MinIO access key for LangFuse (read/write on the `langfuse` bucket only).
LANGFUSE_S3_ACCESS_KEY=langfuse
# Secret.
LANGFUSE_S3_SECRET_KEY=
# Project API keys created on first LangFuse boot; the API and worker send traces with them. Secret.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# First LangFuse login (local only).
LANGFUSE_INIT_USER_EMAIL=admin@pairly.localhost
# Secret.
LANGFUSE_INIT_USER_PASSWORD=
