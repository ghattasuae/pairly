{
  "name": "@pairly/web",
  "version": "0.0.0",
  "private": true,
  "description": "Pairly web app (Next.js App Router, Better Auth, next-intl).",
  "license": "(AGPL-3.0-only OR LicenseRef-Proofly-Commercial)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdfjs.mjs && next dev --port 3100",
    "build": "node scripts/copy-pdfjs.mjs && next build",
    "start": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "auth:migrate": "tsx scripts/auth-migrate.ts",
    "auth:schema": "tsx scripts/auth-migrate.ts --print",
    "storybook": "node scripts/copy-pdfjs.mjs && storybook dev --port 6006 --no-open",
    "build-storybook": "node scripts/copy-pdfjs.mjs && storybook build --output-dir storybook-static",
    "test:storybook": "pnpm build-storybook && node scripts/storybook-smoke.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@pairly/shared-ts": "workspace:*",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.15",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
