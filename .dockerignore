#
# Build context for infra/docker/*.Dockerfile is the repo root. Keep it small and
# keep secrets out of every image.

# Secrets
.env
.env.*
!.env.example
**/*.pem
**/*.key

# VCS and editors
.git
.github
.idea
.vscode
**/.DS_Store

# Python
**/.venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
.import_linter_cache
.coverage
.coverage.*
htmlcov
**/*.egg-info
**/build
**/dist

# JS
**/node_modules
**/.next
**/.turbo
**/coverage
**/*.tsbuildinfo
**/storybook-static
**/playwright-report
**/test-results

# Not needed inside any image. synth/ and infra/postgres/ stay in the context: the
# hosted demo builds copy them (python.Dockerfile target `demo`, infra/fly/db/Dockerfile);
# every other image copies named folders only, so they never land there.
docs
evals
infra/minio
BRIEF.md
**/tests
