meta {
  name: Create an endpoint
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/webhooks/endpoints
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "url": "https://example.com/webhooks/pairly",
    "event_types": [
      "batch.completed",
      "approval.decided"
    ],
    "description": "Bruno"
  }
}

docs {
  Person only (core.webhooks.manage, TOTP). The response holds the whsec_ signing secret once.
}
