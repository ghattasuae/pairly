meta {
  name: Submit a batch of URLs
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/documents/batch?workflow={{workflow}}
  body: json
  auth: inherit
}

params:query {
  workflow: {{workflow}}
}

headers {
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "urls": [
      "https://files.example.com/invoice-1001.pdf"
    ],
    "metadata": {
      "source": "bruno"
    }
  }
}

script:post-response {
  bru.setVar('batchId', res.body.id);
}

docs {
  Up to 50 files or URLs. URLs are fetched with SSRF protection after the 202. batch.completed fires when every item has an outcome. Pay needs pay.invoice.upload.
}
