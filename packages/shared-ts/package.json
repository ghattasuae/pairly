{
  "name": "@pairly/shared-ts",
  "version": "0.0.0",
  "private": true,
  "description": "TypeScript types generated from the Pairly OpenAPI schema.",
  "license": "(AGPL-3.0-only OR LicenseRef-Proofly-Commercial)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["src", "openapi"],
  "scripts": {
    "gen:api": "node scripts/gen-api.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "~6.0.3"
  }
}
